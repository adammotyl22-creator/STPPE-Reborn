  <origin xyz="-0.003249 -0.008852 0.080897" rpy="0 0 0"/>
  <parent link="link_1"/>
  <child link="link_2"/>
  <axis xyz="0.34202 0.939693 0"/>
  <limit lower="-1.134464" upper="2.007129" effort="100" velocity="100"/>
</joint>

<!-- ======================================================================= -->
<!-- LINK 2 (Upper Arm / Przedramie Core)                                    -->
<!-- ======================================================================= -->
<link name="link_2">
